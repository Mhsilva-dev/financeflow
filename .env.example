# ============================================
# FinanceFlow — configurações
# ============================================
# Copie este arquivo: cp .env.example .env

# ----- SERVIDOR -----
PORT=3001
NODE_ENV=development
# Em produção o app escuta só em 127.0.0.1 (o Nginx faz a ponte com HTTPS)
# HOST=127.0.0.1

# Endereço público do app (base dos links enviados por e-mail e origem permitida no CORS)
# APP_URL=https://seu-dominio.com.br
# ALLOWED_ORIGINS=https://seu-dominio.com.br

# ----- SEGURANÇA -----
# String aleatória longa: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque_por_uma_chave_aleatoria_longa

# false fecha o cadastro de novas contas
REGISTRO_ABERTO=true

# ----- BANCO DE DADOS -----
DB_PATH=./database/financeflow.db

# ----- ASSISTENTE (Google Gemini) -----
# Chave gratuita em https://aistudio.google.com — sem ela o app funciona, só o assistente fica indisponível
GEMINI_API_KEY=

# ----- NOTIFICAÇÕES PUSH (alerta de gasto) -----
# Gere o par de chaves com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seu-dominio.com.br

# ----- E-MAIL ("esqueci a senha") -----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="FinanceFlow <contato@seu-dominio.com.br>"

# ----- PDF (Puppeteer) -----
# Caminho do Chromium usado para gerar relatórios em PDF
# CHROMIUM_PATH=/usr/bin/chromium-browser
